# Banco de dados PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
# Na Vercel/Neon, as variáveis precisam se chamar exatamente DATABASE_URL e
# DATABASE_URL_UNPOOLED — a integração do Neon (prefixo DATABASE) já as cria.
#
# DATABASE_URL: conexão POOLED (PgBouncer) — usada pela aplicação em runtime.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
# DATABASE_URL_UNPOOLED: conexão DIRETA — usada por `prisma migrate deploy`.
# Em dev local pode apontar para a mesma URL direta do Postgres local.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do NextAuth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"
# Em produção defina a URL pública, ex.: https://seuapp.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Credenciais do administrador (usadas pelo script de seed para criar o login)
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
