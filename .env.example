# Banco de dados PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do NextAuth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"
# Em produção defina a URL pública, ex.: https://seuapp.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Credenciais do administrador (usadas pelo script de seed para criar o login)
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
